# Panel layout is intentionally absent. Plasma only runs its default panel
# script when this file has no containments, and a group named <id> is loaded
# as containment 0, which is a brand new empty panel (the "Add Widgets" bar).
# 10-bananos-default-panel.js adds the stock panel on first login.

[Containments][2]
formfactor=0
immutability=1
lastScreen=0
location=0
plugin=org.kde.plasma.folder
wallpaperplugin=org.kde.color

[Containments][2][Wallpaper][org.kde.color][General]
Color=0,0,0
