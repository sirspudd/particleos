#!/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
set -e

if command -v authselect >/dev/null; then
    authselect select local
    authselect enable-feature with-systemd-homed
fi

if [[ -d /etc/pam.d ]]; then
    find /etc/pam.d -mindepth 1 -exec mv {} /usr/lib/pam.d \;
    rmdir /etc/pam.d
fi

# Get rid of obsolete stuff in the pam stack.
find /usr/lib/pam.d/ -mindepth 1 -exec sed --in-place '/pam_shells.so/d' {} \;
find /usr/lib/pam.d/ -mindepth 1 -exec sed --in-place '/pam_securetty.so/d' {} \;

# Fedora disables the userdb ssh dropin by default, but helpfully leaves it available in
# the package so that we can just symlink it to a name that will be picked up by systemd-tmpfiles.
if [[ -f /usr/lib/tmpfiles.d/20-systemd-userdb.conf.example ]]; then
    ln --symbolic 20-systemd-userdb.conf.example /usr/lib/tmpfiles.d/20-systemd-userdb.conf
fi

# Give BananOS its own identity/branding via os-release +
# issue. Note that we keep the original $ID, $VERSION and $VERSION_ID
# in place, so that we appear like the original underlying OS in most
# programmatic ways. However, all "pretty"/"fancy" strings now claim
# we are BananOS. Moreover, use $ID_LIKE to identify ParticleOs as
# such in a programmatic way.
(
    . /usr/lib/os-release
    cat >/usr/lib/os-release <<EOF
NAME="BananOS ($NAME Flavour)"
ID="$ID"
ID_LIKE="particleos-$ID"
PRETTY_NAME="BananOS/$NAME $VERSION"
FANCY_NAME="\033[0;38:2:252:186:3;1;49m⸭\033[0;38:2:252:186:3;49m BananOS/$NAME Flavour $VERSION\033[0m"
VERSION="$VERSION"
VERSION_ID="$VERSION_ID"
ANSI_COLOR="38:2:252:186:3;1;49"
ANSI_COLOR_REVERSE="48;2;252;186;3;1;30"
DEFAULT_HOSTNAME="particle-????-????"
HOME_URL="https://github.com/systemd/particleos/"
EOF

    cat >/usr/lib/issue <<EOF
\e[0;38:2:252:186:3;1;49m▒\e[0m \e[0;38:2:252:186:3;1;49m⸭\e[0;38:2:252:186:3;49m BananOS/$NAME Flavour $VERSION\e[0m
\e[0;38:2:252:186:3;1;49m▒\e[0m Kernel \r on an \m (\l)

EOF
)

# I love static libraries, thats why I love to kill em
find /usr | grep \\.a$ | xargs rm

# gotta remove cruft the old fashion way to avoid duc indexing stale content
rm -Rf \
        /usr/include \
        /usr/share/wallpapers/ \
        /usr/share/man \
        /usr/share/doc \
        /usr/share/icons/oxygen \
        /usr/share/locale \
        /usr/share/gtk-doc \
        /usr/lib/firmware/intel \
        /usr/lib/firmware/intel-ucode

# Noto CJK is one static collection per weight and those files barely compress
# (~226 MiB in the usr partition). One Sans face is enough. Keep
# NotoSansCJK-Regular.ttc and drop Serif and the other Sans weights before
# fc-cache so the font cache matches the tree. RemoveFiles= in the arch
# bananos config repeats this for the final image.
if [[ -d /usr/share/fonts/noto-cjk ]]; then
    find /usr/share/fonts/noto-cjk -type f \
        ! -name 'NotoSansCJK-Regular.ttc' \
        -delete
fi

# Omarchy theme config (colors, neovim, vscode) is tiny. The space is wallpaper
# and preview images under each theme, ~110 MiB, which barely compress.
if [[ -d /usr/share/omarchy/themes ]]; then
    find /usr/share/omarchy/themes -type d -name backgrounds -prune -exec rm -rf {} +
    find /usr/share/omarchy/themes -type f \( -name '*.png' -o -name '*.jpg' \) -delete
fi

fc-cache -f

# just learned this is dirty; good, I am dirty
mv /opt /usr

# goofy; duc does not create the directory tree
# goofier; only /usr is going so this provisioning has to be under /usr if we want it packed
#mkdir -p /root/.cache/duc
mkdir -p /usr/lib/duc
# duc compresses index records (RECORD_COMP_ZSTD) unless --uncompressed is
# passed. This duc-git build still writes ~500 MiB because its Tkrzw HashDBM
# open string is malformed ("offset_,num_buckets=100ets=10000000000"), so
# tkrzw falls back to a ~1e8-bucket table of 5-byte offsets. That table is
# almost all zero bytes and is not covered by record compression. The erofs
# image shrinks it to ~2 MiB; the workspace file stays ~479 MiB.
duc index /usr -d /usr/lib/duc/duc.db

sed -i 's|/opt/google/|/usr/opt/google/|g' /bin/google-chrome-beta

# drkonqi is noisy
# rm /usr/lib/systemd/user/drkonqi-coredump-launcher.socket
# rm /usr/lib/systemd/user/sockets.target.wants/drkonqi-coredump-launcher.socket

#rm /usr/lib/systemd/network/89-ethernet.network
