#!/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later

# systemd-repart in the initrd reads partition definitions from the signed
# /usr, which cannot be edited. Copy them onto /run and pin the swap
# partition to the size of RAM so hibernation has room for the image.
#
# If repart fails and the boot disk has no root partition yet (typically a
# raw image or USB stick without free space behind it), boot with a tmpfs
# root instead, as the live profile does, rather than waiting forever for
# a root partition that will never appear.

set -euo pipefail

# Prints the whole disk backing /sysusr/usr, looking through dm-verity.
boot_disk() {
    local majmin dev slaves
    majmin=$(while read -r _ _ mm _ mp _; do
        if [[ $mp == /sysusr/usr ]]; then echo "$mm"; fi
    done </proc/self/mountinfo)
    [[ -n $majmin ]] || return 1

    dev=$(readlink -f "/sys/dev/block/$majmin")
    slaves=("$dev"/slaves/*)
    if [[ -e ${slaves[0]:-} ]]; then
        dev=$(readlink -f "${slaves[0]}")
    fi
    if [[ -e $dev/partition ]]; then
        dev=$(readlink -f "$dev/..")
    fi
    echo "/dev/${dev##*/}"
}

# udev's dissect_image builtin tags the boot disk with one
# ID_DISSECT_PART<n>_DESIGNATOR= property per recognized partition. The
# initrd has no grep, so match in bash.
has_root_partition() {
    local disk props line
    disk=$(boot_disk) || return 0  # Can't tell, so assume there is one.
    props=$(udevadm info --query=property --name="$disk") || return 0

    while IFS= read -r line; do
        if [[ $line =~ ^ID_DISSECT_PART[0-9]+_DESIGNATOR=root$ ]]; then
            return 0
        fi
    done <<<"$props"

    return 1
}

tmpfs_root() {
    echo "No root partition and none could be created, falling back to a tmpfs root" >&2

    # Replace the sysroot.mount and root device dependency written by
    # systemd-gpt-auto-generator. /run/systemd/system takes precedence over
    # the generator directories, including for same-named drop-ins.
    mkdir -p /run/systemd/system/initrd-root-device.target.d
    cat >/run/systemd/system/initrd-root-device.target.d/50-root-device.conf <<EOF
# Masks the generated root device dependency, there is no root device.
EOF
    cat >/run/systemd/system/sysroot.mount <<EOF
[Unit]
Description=Root File System (tmpfs fallback)
Before=initrd-root-fs.target

[Mount]
What=rootfs
Where=/sysroot
Type=tmpfs
Options=mode=0755,rw
EOF

    # PID 1 imports /run/credentials/@initrd as system credentials after the
    # switch to the host, early enough for system.hostname.
    local creds=/run/credentials/@initrd
    mkdir -p -m 0700 "$creds"

    # Same credentials the live profile passes on its command line.
    printf particleos >"$creds/passwd.plaintext-password.root"
    printf root >"$creds/agetty.autologin"
    printf yes >"$creds/login.noauth"

    # Every tmpfs boot is a first boot, so instead of prompting via first-run
    # (masked below), set up what its defaults would give: hostname ponyhof
    # and user toadwart with the same shell and groups, logged straight into
    # Plasma. The password is "particleos", as for root.
    printf ponyhof >"$creds/system.hostname"
    printf /usr/bin/zsh >"$creds/passwd.shell.root"

    cat >"$creds/userdb.transient.user.toadwart" <<'EOF'
{
    "userName": "toadwart",
    "uid": 1000,
    "gid": 1000,
    "disposition": "regular",
    "homeDirectory": "/home/toadwart",
    "shell": "/usr/bin/zsh",
    "memberOf": ["wheel", "systemd-journal", "libvirt", "libvirt-qemu", "uucp", "kvm", "render", "video"],
    "privileged": {
        "hashedPassword": ["$6$bananoslive$UZwy9.kOXFH29vDgaoIF37dBBkhjl.gEGrdWMd6qd/reocRPs4JmvYwf7hUTFSRUvZvtOmRGa9XZ8Xr.UZJWq/"]
    }
}
EOF
    cat >"$creds/userdb.transient.group.toadwart" <<'EOF'
{
    "groupName": "toadwart",
    "gid": 1000,
    "disposition": "regular"
}
EOF

    # Numeric ownership, the userdb records may not be loaded yet when
    # systemd-tmpfiles-setup.service runs.
    cat >"$creds/tmpfiles.extra" <<'EOF'
C /home/toadwart 0700 1000 1000 - /usr/share/factory/etc/skel
Z /home/toadwart - 1000 1000 -
f /etc/subuid 0644 - - - toadwart:524288:65536\n
f /etc/subgid 0644 - - - toadwart:524288:65536\n
f /etc/plasmalogin.conf.d/50-tmpfs-autologin.conf 0644 - - - [Autologin]\nUser=toadwart\nSession=plasma\n
EOF

    chmod 0400 "$creds"/*

    # Don't prompt for a user that is gone at the next power-off.
    # /run/systemd/system carries over into the host.
    ln -sf /dev/null /run/systemd/system/systemd-homed-firstboot.service

    systemctl daemon-reload
}

repart() {
    local rc=0
    systemd-repart --dry-run=no "$@" || rc=$?

    # 76 and 77 are listed in SuccessExitStatus= of systemd-repart.service.
    if (( rc == 0 || rc == 76 || rc == 77 )); then
        exit "$rc"
    fi
    if has_root_partition; then
        exit "$rc"
    fi

    tmpfs_root
    exit 0
}

src=/sysusr/usr/lib/repart.d
if [[ ! -d $src ]]; then
    repart
fi

mem_kib=
while read -r key value _; do
    if [[ $key == MemTotal: ]]; then
        mem_kib=$value
        break
    fi
done </proc/meminfo

if [[ -z ${mem_kib:-} || $mem_kib -le 0 ]]; then
    repart
fi

# Ceil to a whole GiB, then add one GiB for the LUKS header and for
# systemd's check that free swap cover 98% of anonymous memory.
gib=$(( (mem_kib + 1048576 - 1) / 1048576 + 1 ))

shopt -s nullglob
files=("$src"/*.conf)
if (( ${#files[@]} == 0 )); then
    repart
fi

mkdir -p /run/repart.d
for srcfile in "${files[@]}"; do
    dest=/run/repart.d/${srcfile##*/}
    : >"$dest"
    while IFS= read -r line || [[ -n ${line:-} ]]; do
        printf '%s\n' "$line"
    done <"$srcfile" >"$dest"
done

cat >>/run/repart.d/40-swap.conf <<EOF

# Filled in at boot from MemTotal. Weight= no longer applies once min equals max.
# A priority above 0 lets repart drop swap when the disk cannot hold it.
SizeMinBytes=${gib}G
SizeMaxBytes=${gib}G
Priority=1000
EOF

echo "Hibernation swap sized to ${gib}G from MemTotal=${mem_kib} KiB"
repart --definitions=/run/repart.d
